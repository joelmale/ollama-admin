# Database
DATABASE_URL="file:/data/ollama-admin.db"
# DATABASE_URL="postgresql://user:pass@host:5432/ollamaadmin"

# App
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Reverse-proxy sub-path deployment (optional, requires a local image build)
# NEXT_PUBLIC_BASE_PATH=/ollama-admin

# Ollama on the Docker host. The official Compose file maps this name on Linux/WSL.
DEFAULT_OLLAMA_URL="http://host.docker.internal:11434"

# Logging
LOG_RETENTION_DAYS=90

# Catalog
CATALOG_REFRESH_ENABLED=true

# HTTP Proxy (optional)
# HTTPS_PROXY=http://proxy.example.com:8080

